# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Only the public anon key goes here — NEVER the service_role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional. Only needed for the Capacitor (Android/iOS) build: the native
# app has no server of its own, so it calls this hosted deployment for
# /api/download-audio and /api/health. Defaults to the production URL
# baked into src/lib/api-config.ts if unset. Not used by the web app.
# NEXT_PUBLIC_API_BASE_URL=https://your-domain.example.com
